{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-improve.local/contracts/device-identity.schema.json",
  "title": "Native hardware device identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "device_id", "created_at"],
  "properties": {
    "version": {"const": 2},
    "kind": {"const": "macos-platform-uuid-sha256-v1"},
    "device_id": {"type": "string", "pattern": "^dev_hw_[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
