{
  "name": "vibe-improve",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "vite --config apps/local-ui/vite.config.ts --host 127.0.0.1",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "tsc --noEmit && vite build --config apps/local-ui/vite.config.ts",
    "test": "node --test tests/*.test.mjs",
    "cloud": "node scripts/cloudbase-cli.mjs",
    "package:mac": "node scripts/package-mac.mjs"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "3.10.2",
    "lucide-react": "1.59.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  }
}
