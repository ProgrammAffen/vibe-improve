{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-improve.local/contracts/runtime-session.schema.json",
  "title": "Encrypted runtime session",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "algorithm", "payload"],
  "properties": {
    "schemaVersion": {"const": 1},
    "algorithm": {"const": "AES-256-GCM"},
    "payload": {"type": "string", "minLength": 40, "maxLength": 53372, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
  }
}
